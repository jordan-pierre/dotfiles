{
  "$schema" : "https:\/\/schema.linearmouse.app\/0.12.0",
  "schemes" : [
    {
      "buttons" : {
        "mappings" : [
          {
            "outcomes" : {
              "shortPress" : "auto"
            },
            "trigger" : {
              "input" : {
                "button" : 1
              }
            }
          },
          {
            "outcomes" : {
              "press" : {
                "action" : "mouse.button.back",
                "behavior" : "remap"
              }
            },
            "trigger" : {
              "input" : {
                "button" : 2
              }
            }
          },
          {
            "outcomes" : {
              "press" : {
                "action" : "mouse.button.forward",
                "behavior" : "remap"
              }
            },
            "trigger" : {
              "input" : {
                "button" : 3
              }
            }
          }
        ]
      },
      "if" : {
        "device" : {
          "category" : "mouse",
          "productID" : "0x80d6",
          "productName" : "Kensington SlimBlade Pro Trackball(2.4GHz Receiver)",
          "vendorID" : "0x47d"
        }
      },
      "pointer" : {
        "acceleration" : 5,
        "disableAcceleration" : false,
        "redirectsToScroll" : false,
        "speed" : 0.25
      },
      "scrolling" : {
        "acceleration" : {
          "vertical" : 3
        },
        "reverse" : {
          "vertical" : true
        },
        "speed" : {
          "vertical" : 42
        }
      }
    },
    {
      "if" : {
        "device" : {
          "category" : "trackpad",
          "productID" : "0x0",
          "productName" : "Apple Internal Keyboard \/ Trackpad",
          "serialNumber" : "FM7HQW0B9ZS0000DZT+ANRM",
          "vendorID" : "0x0"
        }
      },
      "scrolling" : {
        "acceleration" : {
          "vertical" : 0.73
        }
      }
    },
    {
      "if" : {
        "device" : {
          "category" : "trackpad",
          "productID" : "0x324",
          "productName" : "Magic Trackpad #2",
          "serialNumber" : "04:41:A5:8B:3C:39",
          "vendorID" : "0x4c"
        }
      },
      "pointer" : {
        "acceleration" : "unset",
        "disableAcceleration" : false,
        "redirectsToScroll" : false,
        "speed" : "unset"
      }
    }
  ]
}